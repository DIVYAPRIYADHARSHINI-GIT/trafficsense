# Copy to .env.local to override locally. Both are read at build time by Vite.

# Backend base URL. Defaults to http://localhost:8000 when unset.
# The GitHub Pages workflow sets this to your Render URL, e.g. https://trafficsense-api.onrender.com
VITE_API_URL=http://localhost:8000

# Public base path. Production builds default to /trafficsense/ (GitHub Pages project site);
# dev server defaults to /. Set to / to serve a build from a domain root.
# VITE_BASE=/trafficsense/

# Set to "1" to never call the backend and always use the bundled offline data.
# VITE_OFFLINE_ONLY=0
