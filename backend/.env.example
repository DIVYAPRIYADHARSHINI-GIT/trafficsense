# All settings are optional; defaults shown. Export them before starting uvicorn.
# TRAFFICSENSE_DATA_DIR=./data              # SQLite DB + generated sample CSV
# TRAFFICSENSE_MODEL_DIR=./models           # joblib model file
# TRAFFICSENSE_FORCE_STATISTICAL=0          # 1 = skip Random Forest, use historical-average model
# TRAFFICSENSE_REUSE_MODEL=0                # 1 = reuse saved model if trained on identical data (faster restarts)
# TRAFFICSENSE_SAMPLE_MAX_AGE_DAYS=7        # regenerate the sample when it ends more than N days ago (0 = never)
# TRAFFICSENSE_SAMPLE_MONTHS=6
# TRAFFICSENSE_SEED=42
# TRAFFICSENSE_MAX_UPLOAD_MB=50
# TRAFFICSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
